{
  // Cloudflare Worker that serves the portfolio and keeps Supabase awake.
  // The name must match the Worker name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  // The Vite build output. Unknown page routes get index.html (SPA).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Daily at 09:00 UTC: one tiny Supabase read so the project never pauses.
  "triggers": {
    "crons": ["0 9 * * *"]
  },

  // Supabase values are set in the dashboard. Don't let deploys wipe them.
  "keep_vars": true,

  "observability": {
    "enabled": true
  }
}
